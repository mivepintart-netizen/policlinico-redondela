# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). NUNCA la service_role / secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend → API Keys
RESEND_API_KEY=

# --- Solo servidor (NUNCA con NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → secret (o service_role)
SUPABASE_SERVICE_ROLE_KEY=
# Stripe → Developers → API keys → Secret key (sk_test_… en pruebas)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → tu endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# --- Emails (Resend) ---
# Remitente; con dominio verificado en Resend, p. ej.: Policlínico Redondela <citas@tudominio.es>
EMAIL_REMITENTE=
# Opcional: a dónde llegan las respuestas de los pacientes
EMAIL_RESPONDER_A=
# Opcional: dirección pública de la web para los enlaces de los emails
NEXT_PUBLIC_SITE_URL=
